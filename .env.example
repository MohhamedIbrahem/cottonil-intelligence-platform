# Copy to .env (gitignored) and fill in your keys.
# Assistant LLM: a provider CHAIN — Gemini first (primary), Groq when Gemini
# fails (quota exhausted, rate limit, outage). Both use OpenAI-compatible APIs.

# --- Primary: Google Gemini (AI Studio / Generative Language API) ------------
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-lite-latest

# --- Fallback: Groq (used automatically when the primary fails) --------------
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Overrides (all optional) ------------------------------------------------
# Any single field may be overridden per role:
#   primary:   COTTONIL_LLM_BASE_URL / COTTONIL_LLM_MODEL / COTTONIL_LLM_API_KEY
#   fallback:  COTTONIL_LLM_FALLBACK_BASE_URL / _MODEL / _API_KEY
# Engine settings:
# COTTONIL_LLM_TIMEOUT=120      # per-completion seconds
# COTTONIL_SQL_TIMEOUT=25       # DuckDB read-only query cap
# COTTONIL_LLM_TEMPERATURE=0.1
