# Copy to .env (gitignored) and adjust as needed.
# Assistant LLM: any OpenAI-compatible endpoint. Default = local Ollama (no key needed).

COTTONIL_LLM_BASE_URL=http://localhost:11434/v1
COTTONIL_LLM_MODEL=llama3.1
# Arabic-tuned alternative: qwen2.5:7b-instruct (better EN<->AR narration)
# COTTONIL_LLM_API_KEY=your-key-if-using-a-cloud-provider
# COTTONIL_LLM_TIMEOUT=120      # per-completion seconds
# COTTONIL_SQL_TIMEOUT=25       # engine query time cap
# COTTONIL_LLM_TEMPERATURE=0.1
